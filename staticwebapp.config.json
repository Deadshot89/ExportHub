{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "routes": [
    {
      "route": "/",
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate",
        "X-ExportHUB-Environment": "test"
      },
      "rewrite": "/index.html"
    },
    {
      "route": "/index.html",
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/test",
      "redirect": "https://wonderful-forest-0f315e310-testservice.centralus.7.azurestaticapps.net/TESTVERSION.html?entry=login",
      "statusCode": 302,
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/test/*",
      "redirect": "https://wonderful-forest-0f315e310-testservice.centralus.7.azurestaticapps.net/TESTVERSION.html?entry=login",
      "statusCode": 302,
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/TESTVERSION.html",
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/testservice-environment.json",
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "no-store",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/pickup",
      "rewrite": "/index.html",
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/pickup.html",
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-ExportHUB-Environment": "test"
      },
      "rewrite": "/index.html"
    },
    {
      "route": "/location",
      "rewrite": "/location.html",
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/location.html",
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/customer-avis",
      "rewrite": "/customer-avis.html",
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate",
        "Pragma": "no-cache",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Cross-Origin-Resource-Policy": "same-origin",
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
        "Content-Security-Policy": "default-src 'none'; connect-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data: https:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/customer-avis.html",
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate",
        "Pragma": "no-cache",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Cross-Origin-Resource-Policy": "same-origin",
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
        "Content-Security-Policy": "default-src 'none'; connect-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data: https:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/api/customer-avis*",
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate",
        "Pragma": "no-cache",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Cross-Origin-Resource-Policy": "same-origin",
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/api/*",
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "no-store",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/.auth/*",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/assets/*",
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/.auth/*",
      "/pickup",
      "/pickup.html",
      "/assets/*",
      "/testservice-environment.json",
      "/*.{css,js,json,png,jpg,jpeg,gif,svg,ico,pdf,webp,woff,woff2}",
      "/location",
      "/location.html",
      "/customer-avis",
      "/customer-avis.html"
    ]
  },
  "platform": {
    "apiRuntime": "node:20"
  },
  "trailingSlash": "never"
}
