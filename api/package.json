{
  "name": "exporthub-api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'),path=require('path');const candidates=[path.resolve('scripts/verify-runtime-sources.cjs'),path.resolve('..','scripts','verify-runtime-sources.cjs')];const script=candidates.find(fs.existsSync);if(!script)throw new Error('verify-runtime-sources.cjs nicht gefunden');require(script);\""
  },
  "dependencies": {
    "@azure/storage-blob": "12.27.0",
    "pdf-lib": "1.17.1",
    "pdf-parse": "2.4.5",
    "exceljs": "4.4.0"
  }
}
