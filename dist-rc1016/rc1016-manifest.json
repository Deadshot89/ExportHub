  "tasks": {
    "lifecycle": "assets/rc1014-task-lifecycle.js",
    "runtime": "assets/rc1014-task-runtime.js",
    "style": "assets/rc1014-task-ui.css"
  },
  "shipmentOverview": {
    "runtime": "assets/rc1014-shipment-overview.js",
