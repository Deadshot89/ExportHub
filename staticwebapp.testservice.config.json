{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "routes": [
    {
      "route": "/",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate",
        "X-ExportHUB-Environment": "test"
      },
      "rewrite": "/TESTVERSION.html"
    },
    {
      "route": "/index.html",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate",
        "X-ExportHUB-Environment": "test"
      },
      "rewrite": "/TESTVERSION.html"
    },
    {
      "route": "/test",
      "rewrite": "/TESTVERSION.html",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/test/*",
      "rewrite": "/TESTVERSION.html",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/TESTVERSION.html",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/testservice-environment.json",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/pickup",
      "rewrite": "/TESTVERSION.html",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/pickup.html",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-ExportHUB-Environment": "test"
      },
      "rewrite": "/TESTVERSION.html"
    },
    {
      "route": "/location",
      "rewrite": "/location.html",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/location.html",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store",
        "X-ExportHUB-Environment": "test"
      }
    },
    {
      "route": "/.auth/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/assets/*",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/TESTVERSION.html",
    "exclude": [
      "/api/*",
      "/.auth/*",
      "/pickup",
      "/pickup.html",
      "/assets/*",
      "/testservice-environment.json",
      "/*.{css,js,json,png,jpg,jpeg,gif,svg,ico,pdf,webp,woff,woff2}",
      "/location",
      "/location.html"
    ]
  },
  "platform": {
    "apiRuntime": "node:20"
  },
  "trailingSlash": "never"
}






