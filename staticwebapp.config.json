{
  "routes": [
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate"
      }
    },
    {
      "route": "/assets/exporthub-ui-rc521.css",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate"
      }
    },
    {
      "route": "/assets/clean-bootstrap.js",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate"
      }
    },
    {
      "route": "/api/pickup-init",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/api/pickup-health",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/api/pickup-status",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/api/pickup-confirm",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/api/pickup-pod",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/api/exporthub/*",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/.auth/*",
      "/pickup.html",
      "/*.{css,js,json,png,jpg,jpeg,gif,svg,ico,pdf}"
    ]
  }
}
