    },
    {
      "route": "/customer-avis",
      "rewrite": "/customer-avis.html",
      "allowedRoles": ["anonymous"],
      "headers": {"Cache-Control": "no-store","Referrer-Policy": "no-referrer","X-Content-Type-Options": "nosniff"}
    },
    {
      "route": "/customer-avis.html",
      "allowedRoles": ["anonymous"],
      "headers": {"Cache-Control": "no-store","Referrer-Policy": "no-referrer","X-Content-Type-Options": "nosniff"}
    },
    {
      "route": "/location",
      "rewrite": "/location.html",
