{
  "routes": [
    {
      "route": "/api/exporthub/health",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/api/exporthub/state",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/exporthub/backup",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/start.html",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/logged-out.html",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/robots.txt",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/*",
      "allowedRoles": ["anonymous", "authenticated"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/.auth/*", "/robots.txt"]
  }
}
