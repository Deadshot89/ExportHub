    "gate41": "assets/rc1013-gate41-ui.js",
    "multiTruck": "assets/rc1017-multi-truck.js"
  },
  "demo": {
    "bridge": "assets/rc1014-demo-bridge.js",
    "taskSeed": "assets/rc1016-demo-task-seed.js",
    "sessionRestore": true,
    "dataEnvironment": "demo",
    "fixedPickups": "fake-local"
  },
  "environments": {
    "production": "index.html",
    "testservice": "TESTVERSION.html",
    "demo": "demo.html"
