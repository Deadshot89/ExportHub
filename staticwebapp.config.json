{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "routes": [
    {
      "route": "/pickup",
      "rewrite": "/pickup.html",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "route": "/pickup.html",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "route": "/customer-avis",
      "rewrite": "/customer-avis.html",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "route": "/customer-avis.html",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "route": "/location",
      "rewrite": "/location.html",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "route": "/location.html",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "route": "/pod-notfall",
      "rewrite": "/pod-notfall.html",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "route": "/pod-notfall.html",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/api/*",
      "/tools/*",
      "/pickup",
      "/pickup.html",
      "/customer-avis",
      "/customer-avis.html",
      "/location",
      "/location.html",
      "/pod-notfall",
      "/pod-notfall.html",
      "/*.{css,js,json,png,jpg,jpeg,gif,svg,ico,pdf,webp,woff,woff2}"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  },
  "platform": {
    "apiRuntime": "node:20"
  },
  "trailingSlash": "never"
}
